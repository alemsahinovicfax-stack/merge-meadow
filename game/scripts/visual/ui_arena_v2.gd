static func basket_visible(count: int) -> int:
	if count <= 0:
		return 0
	return clampi(roundi(count * 12.0 / 40.0), 1, 12)


static func combo_step(n: int) -> Dictionary:
	if n < 2:
		return {}
	return COMBO_STEPS[mini(n, 6) - 2]


static func field(season_id: String) -> Dictionary:
	return FIELDS.get(season_id, FIELDS["country_bloom"])


## Instanca rasutog elementa: {pos (% ), size, rot (deg), palette, avoided}. Isto kao scatterInstance u JS.
static func scatter_instance(s: Dictionary, i: int) -> Dictionary:
	var ph: Array = s["phase"]
	var x := 0.0
	var y := 0.0
	if s.has("at"):
		var a: Array = s["at"][i % s["at"].size()]
		x = a[0]; y = a[1]
	elif s.get("even", false):
		var z: Array = s["zones"][0]
		x = z[0] + (i + 0.5) / float(s["n"][1]) * z[2]; y = z[1] + z[3] * 0.5
	else:
		var zones: Array = s["zones"]
		var z: Array = zones[i % zones.size()]
		var k := i / zones.size()
		x = z[0] + fposmod(ph[0] + R2_A1 * (k + 1), 1.0) * z[2]
		y = z[1] + fposmod(ph[1] + R2_A2 * (k + 1), 1.0) * z[3]
	var sz: Array = s["size"]
	var rt: Array = s["rot"]
	var size := lerpf(sz[0], sz[1], fposmod(ph[2] + R2_SIZE * (i + 1), 1.0))
	var rot := lerpf(rt[0], rt[1], fposmod(ph[3] + R2_ROT * (i + 1), 1.0))
	var palette: Array = s["variants"][i % s["variants"].size()] if s.has("variants") else s["palette"]
	var avoided := false
	if not s.get("noAvoid", false):
		for a in AVOID:
			if x >= a[0] and x <= a[0] + a[2] and y >= a[1] and y <= a[1] + a[3]:
				avoided = true
	return {"pos": Vector2(x, y), "size": size, "rot": rot, "palette": palette, "avoided": avoided}


static func scatter_alpha(s: Dictionary, i: int, level: float) -> float:
	var n: Array = s["n"]
	return clampf(n[0] + (n[1] - n[0]) * level / 4.0 - i, 0.0, 1.0)


static func scatter_grow(s: Dictionary, level: float) -> float:
	var g: Array = s["grow"]
	return lerpf(g[0], g[1], level / 4.0)


static func layer_color(fill: Array, level: float) -> Color:
	return Color(fill[0]).lerp(Color(fill[1]), level / 4.0)


## Boja iz exporta: "#RRGGBB", "#RRGGBBAA" ili "rgba(r,g,b,a)" (sjene, led).
static func col(value: String) -> Color:
	if value.begins_with("rgba("):
		var parts := value.trim_prefix("rgba(").trim_suffix(")").split(",")
		return Color(
			parts[0].to_float() / 255.0, parts[1].to_float() / 255.0,
			parts[2].to_float() / 255.0, parts[3].to_float()
		)
	return Color(value)
