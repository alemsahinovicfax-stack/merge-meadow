theme_override_constants/margin_bottom = 6

[node name="FooterHBox" type="HBoxContainer" parent="FooterBar"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MergeButton" type="PanelContainer" parent="FooterBar/FooterHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_uibtn")
label_text = "Merge"
font_size = 26
button_variant = "accent"

[node name="PlayButton" type="PanelContainer" parent="FooterBar/FooterHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_uibtn")
label_text = "Play"
font_size = 28
button_icon = "play"
button_variant = "primary"

